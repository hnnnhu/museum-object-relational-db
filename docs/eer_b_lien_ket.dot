// Hình 4.1b – EER: các kiểu liên kết (ký pháp Elmasri & Navathe)
// Hình thoi: kiểu liên kết · số 1/N/M: tỉ số bản số · đường đôi: tham gia toàn phần
// Chỉ ghi thuộc tính khóa của thực thể (thuộc tính đầy đủ ở Hình 4.1a) và thuộc tính của liên kết.
graph EER_B {
    graph [fontname="DejaVu Sans", fontsize=11, layout=neato, overlap=false, sep="+14", splines=true,
           label="Hình 4.1b – Các kiểu liên kết", labelloc=t];
    node  [fontname="DejaVu Sans", fontsize=10];
    edge  [fontname="DejaVu Sans", fontsize=11, len=1.3];

    HienVat     [shape=box, style=filled, fillcolor="#e8f0fe", label="HIỆN_VẬT", pos="0,0!"];
    TacGia      [shape=box, label="TÁC_GIẢ",        pos="-4.2,2.2!"];
    ChatLieu    [shape=box, label="CHẤT_LIỆU",      pos="-4.6,-0.4!"];
    BoSuuTap    [shape=box, label="BỘ_SƯU_TẬP",     pos="0,3.2!"];
    Phong       [shape=box, label="PHÒNG_TRƯNG_BÀY", pos="4.2,2.4!"];
    TrienLam    [shape=box, label="TRIỂN_LÃM",      pos="4.8,-0.2!"];
    ThanhPhan   [shape=box, label="THÀNH_PHẦN",     pos="-3.4,-3.4!"];
    TaiNguyen   [shape=box, label="TÀI_NGUYÊN_SỐ",  pos="0.4,-3.8!"];
    LichSu      [shape=box, label="LỊCH_SỬ_BẢO_QUẢN", pos="4.2,-3.2!"];

    r_st [shape=diamond, label="SÁNG_TÁC",       pos="-2.2,1.2!"];
    r_lb [shape=diamond, label="LÀM_BẰNG",       pos="-2.4,-0.2!"];
    r_th [shape=diamond, label="THUỘC",          pos="0,1.6!"];
    r_tb [shape=diamond, label="TRƯNG_BÀY_TẠI",  pos="2.3,1.3!"];
    r_tg [shape=diamond, label="THAM_GIA",       pos="2.5,-0.1!"];
    r_gom[shape=diamond, label="GỒM",            pos="-1.7,-1.8!"];
    r_ct [shape=diamond, label="CẤU_THÀNH",      pos="-5.6,-1.9!"];
    r_ctn[shape=diamond, label="CÓ_TÀI_NGUYÊN",  pos="0.2,-1.9!"];
    r_gn [shape=diamond, label="GHI_NHẬN",       pos="2.3,-1.7!"];

    // SÁNG_TÁC M:N, thuộc tính vai_tro
    HienVat -- r_st [label="M"];  r_st -- TacGia [label="N"];
    a_vt [shape=ellipse, label="vai_tro", pos="-2.2,2.4!"]; r_st -- a_vt [len=0.6];
    // LÀM_BẰNG M:N
    HienVat -- r_lb [label="M"];  r_lb -- ChatLieu [label="N"];
    // THUỘC N:1 – hiện vật thuộc tối đa 1 bộ sưu tập (bộ phận)
    HienVat -- r_th [label="N"];  r_th -- BoSuuTap [label="1"];
    // TRƯNG_BÀY_TẠI N:1 – bộ phận (chỉ hiện vật đang trưng bày)
    HienVat -- r_tb [label="N"];  r_tb -- Phong [label="1"];
    // THAM_GIA M:N, thuộc tính vi_tri
    HienVat -- r_tg [label="M"];  r_tg -- TrienLam [label="N"];
    a_vi [shape=ellipse, label="vi_tri", pos="2.9,-1.0!"]; r_tg -- a_vi [len=0.6];
    // GỒM 1:N – thành phần phụ thuộc hiện vật (toàn phần phía thành phần)
    HienVat -- r_gom [label="1"];  r_gom -- ThanhPhan [label="N", color="black:invis:black"];
    // CẤU_THÀNH – liên kết đệ quy trên THÀNH_PHẦN với hai vai trò
    ThanhPhan -- r_ct [taillabel="cha 1", labeldistance=3.5, labelangle=-25];  ThanhPhan -- r_ct [taillabel="con N", labeldistance=3.5, labelangle=25];
    a_sl [shape=ellipse, label="so_luong", pos="-3.4,-4.6!"]; ThanhPhan -- a_sl [len=0.6];
    // CÓ_TÀI_NGUYÊN 1:N – toàn phần phía tài nguyên
    HienVat -- r_ctn [label="1"];  r_ctn -- TaiNguyen [label="N", color="black:invis:black"];
    // GHI_NHẬN 1:N – toàn phần phía lịch sử (xóa theo hiện vật)
    HienVat -- r_gn [label="1"];  r_gn -- LichSu [label="N", color="black:invis:black"];

    // Khóa của các thực thể
    k_hv [shape=ellipse, label=<<U>ma_hv</U>>, pos="1.4,0.55!"]; HienVat -- k_hv [len=0.5];
    k_tg [shape=ellipse, label=<<U>ma_tac_gia</U>>, pos="-5.4,2.9!"]; TacGia -- k_tg;
    k_cl [shape=ellipse, label=<<U>ten</U>>, pos="-5.9,-1.0!"]; ChatLieu -- k_cl;
    k_bst[shape=ellipse, label=<<U>ma_bst</U>>, pos="-1.2,3.9!"]; BoSuuTap -- k_bst;
    k_ph [shape=ellipse, label=<<U>ma_phong</U>>, pos="5.6,3.1!"]; Phong -- k_ph;
    a_sc [shape=ellipse, label="suc_chua", pos="5.8,1.8!"]; Phong -- a_sc;
    k_tl [shape=ellipse, label=<<U>ma_tl</U>>, pos="6.2,0.4!"]; TrienLam -- k_tl;
    k_tp [shape=ellipse, label=<<U>ma_tp</U>>, pos="-2.2,-4.4!"]; ThanhPhan -- k_tp;
    k_tn [shape=ellipse, label=<<U>ma_tn</U>>, pos="1.7,-4.6!"]; TaiNguyen -- k_tn;
    k_ls [shape=ellipse, label=<<U>ma_ls</U>>, pos="5.6,-3.9!"]; LichSu -- k_ls;
}
